 #include "grbl.h"
+#include <util/atomic.h>   // ATOMIC_BLOCK for the ISR-shared sys.pending_colour
 
 // Define line flags. Includes comment type tracking and line overflow detection.
 #define LINE_FLAG_OVERFLOW bit(0)
@@ -237,6 +238,29 @@ void protocol_exec_rt_system()
     system_clear_exec_alarm(); // Clear alarm
   }
 
+  // Emit pending LED colour change message [C:n] for ESP32-C3 to forward via ESP-NOW.
+  // n is 24-bit RGB (0=black/off, 1-16777215=colour). 0xFFFFFFFF is internal sentinel for P=0.
+  // sys.pending_colour is written by the stepper ISR (stepper.c) and read here in the
+  // main loop. It is 32-bit on an 8-bit AVR, so the read-and-clear is four instructions
+  // and the ISR can land in the middle of it — losing a colour change, or worse,
+  // returning a torn value that would put a wrong colour on the carrier. Take it under
+  // ATOMIC_BLOCK. The unguarded test below is only a cheap hint: a torn read that comes
+  // back zero merely defers the emit by one loop pass, and the real value is re-read
+  // atomically. The ISR side needs no guard — main-loop code cannot preempt an ISR.
+  if (sys.pending_colour) {
+    uint32_t c;
+    ATOMIC_BLOCK(ATOMIC_RESTORESTATE) {
+      c = sys.pending_colour;
+      sys.pending_colour = 0;
+    }
+    if (c) {
+      if (c == 0xFFFFFFFF) { c = 0; } // P=0 (black) was stored as 0xFFFFFFFF to distinguish from "no change"
+      printPgmString(PSTR("[C:"));
+      print_uint32_base10(c);
+      printPgmString(PSTR("]\r\n"));
+    }
+  }
+
   rt_exec = sys_rt_exec_state; // Copy volatile sys_rt_exec_state.
   if (rt_exec) {
 
